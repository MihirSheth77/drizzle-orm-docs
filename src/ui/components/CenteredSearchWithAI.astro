<div class="nav_search-wrap">
  <div class="search-wrap--centered" id="docsearch"></div>
  <button id="custom-button" class="nav_ai-btn" data-inkeep-sidebar-chat-trigger>
    <span>Ask AI</span>
  </button>
</div>
<script type="module" is:inline>
  docsearch({
    container: '#docsearch',
    appId: "MXZNUT59HV",
    apiKey: "7c390e262ac8858df0b6624d01d9dfef",
    indexName: "orm-drizzle",
    placeholder: "Search documentation...",
  });

  function initInkeepSidebar() {
    // Prevent multiple initializations
    if (window.inkeepSidebarWidget) {
      return;
    }
    
    if (typeof Inkeep === 'undefined') {
      setTimeout(initInkeepSidebar, 100);
      return;
    }

    // Check if container exists
    const container = document.querySelector('#inkeep-sidebar-container');
    if (!container) {
      console.error('Inkeep sidebar container not found!');
      return;
    }
    
    // Check if button exists
    const button = document.querySelector('[data-inkeep-sidebar-chat-trigger]');
    if (!button) {
      setTimeout(initInkeepSidebar, 100);
      return;
    }

    try {
      // Get current theme
      let themeName = localStorage.getItem("theme");
      if (themeName === "system") {
        themeName = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      }
      
      // First parameter is the target selector
      const inkeepWidget = Inkeep.SidebarChat('#inkeep-sidebar-container', {
        baseSettings: {
          apiKey: 'YOUR_INKEEP_API_KEY', // TODO: Replace with new API key before PR
          primaryBrandColor: '#C8FF00', // Drizzle's green color
          organizationDisplayName: 'Drizzle ORM',
          theme: {
            colorMode: {
              forcedColorMode: themeName || 'dark',
            },
            styles: [
              {
                key: 'inkeep-custom-styles',
                type: 'link',
                value: '/inkeep-styles.css'
              }
            ]
          },
        },
        aiChatSettings: {
          aiAssistantAvatar: '/svg/drizzle.svg',
          aiAssistantName: 'Drizzle AI',
          aiGreeting: "Hi! I'm Drizzle AI. I'm here to help you with any questions about Drizzle ORM.",
          exampleQuestions: [
            "How do I get started with Drizzle?",
            "What databases does Drizzle support?",
            "How do I write migrations?",
            "Show me how to use relations"
          ],
        },
        triggerSelector: '[data-inkeep-sidebar-chat-trigger]',
        position: 'right',
        defaultOpen: false,
        minWidth: 300,
        maxWidth: 700,
        defaultWidth: 450,
        autoCloseThreshold: 0.7,
      });

      window.inkeepSidebarWidget = inkeepWidget;
      
      // Give the widget time to fully initialize
      setTimeout(() => {
        console.log('Inkeep sidebar ready');
      }, 200);
    } catch (error) {
      console.error('Error initializing Inkeep sidebar:', error);
    }
  }

  // Start initialization
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInkeepSidebar);
  } else {
    initInkeepSidebar();
  }
</script>
